# ==============================================================================
# 9898048483 Adapter OS v10.0 - Universal AI Gateway
# Copy this file to `.env` and fill in your provider keys.
# Comma-separated keys are rotated round-robin per provider.
# ==============================================================================

# --- Server ---------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
PROMETHEUS_ENABLED=true

# --- Security -------------------------------------------------------------
# Require a gateway key on every request (Authorization: Bearer <key>).
REQUIRE_GATEWAY_KEY=false
GATEWAY_API_KEY=adapter-os-local

# Comma-separated IP allowlist. Empty = allow all.
IP_ALLOWLIST=

# Comma-separated CORS origins. * = allow all.
ALLOWED_ORIGINS=*

# Per-IP rate limiting.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# --- Provider keys --------------------------------------------------------
# Anthropic (https://console.anthropic.com) - Messages API
ANTHROPIC_API_KEY=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Mistral (https://console.mistral.ai)
MISTRAL_API_KEY=

# Cohere (https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=

# --- Local / self-hosted --------------------------------------------------
# Optional auth tokens for Ollama / vLLM (usually not needed on localhost).
OLLAMA_API_KEY=
VLLM_API_KEY=

# Custom base URLs for local deployments (override defaults).
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8000

# --- Fallback engine ------------------------------------------------------
# Ordered provider chain used when the primary provider fails/rate-limits.
FALLBACK_CHAIN=anthropic,gemini,deepseek,openrouter,ollama
