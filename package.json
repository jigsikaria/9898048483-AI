{
  "name": "9898048483adapter-os",
  "version": "10.0.0",
  "description": "Universal AI Gateway & Cross-Platform Adapter - Transforms any AI provider into an OpenAI-compatible endpoint",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:node": "tsx watch src/index.ts",
    "start": "bun run src/index.ts",
    "start:node": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "gui:dev": "cd gui && npm run tauri dev",
    "gui:build": "cd gui && npm run tauri build",
    "docker:build": "docker build -t adapter-os:latest .",
    "docker:up": "docker compose up -d"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  }
}
